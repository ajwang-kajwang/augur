# OKX paper-trading API credentials.
# Create these in the OKX demo trading console:
#   https://www.okx.com/account/my-api
# Use a separate, disposable passphrase that is NOT reused elsewhere.
OKX_API_KEY=your-api-key-here
OKX_SECRET_KEY=your-secret-key-here
OKX_PASSPHRASE=your-passphrase-here

# Trading gate. Default is CLOSED — signals are logged but not submitted.
# Set to 1 to enable order submission to the OKX paper-trading endpoint.
# The x-simulated-trading: 1 header is always sent, so enabling this
# routes orders to paper, never to live funds.
AUGUR_TRADING_ENABLED=0

# Account equity in USDT used by the risk engine for position sizing.
# The FMG strategy allocates 1% of this per primary (Golden) entry.
AUGUR_ACCOUNT_BALANCE=10000

# Rust log level. Options: error | warn | info | debug
# Recommended: info for normal operation, debug when troubleshooting.
RUST_LOG=info
