[Unit]
Description=Augur algorithmic trading bot (OKX BTC-USDT-SWAP)
Documentation=https://github.com/your-username/augur
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=augur
Group=augur
WorkingDirectory=/opt/augur
ExecStart=/opt/augur/augur
EnvironmentFile=/opt/augur/.env

# Restart on failure — but rate-limit to avoid runaway loops if
# OKX returns a persistent auth error.
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging — both stdout and stderr go to journald, structured by unit.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=augur

# Hardening. The bot has no business touching anything outside its
# working directory, so lock it down.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/augur
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# Memory / CPU limits — the Jetson Orin Nano has 8GB and we're not
# even close to using it, but setting a ceiling catches runaway leaks.
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
